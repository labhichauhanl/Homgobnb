<% layout('layouts/boilerplate') %>

    <body>
        <h1>This is my travel website.</h1>
        <!-- <form action="/listings/new" method="GET">
        <button type="submit">Add New Listing</button> 
    </form> -->
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
        
        <% for (let listing of allListings) { %>
            <div class="card col" >
                <img src="<%= listing.image.url %>" class="card-img-top" style= "height: 20rem" alt="listing_image">
                <div class="card-body">
                    <p class="card-text"><b><%= listing.title %></b>
                    <br>
                &#8377; <%= listing.price.toLocaleString('en-IN') %> / Night</p>
                </div>
            </div>
            <% } %>
    </div>
    </body>