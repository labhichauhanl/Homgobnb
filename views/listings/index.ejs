<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/css/index.css">

    <div id="filters">

        <div class="filter active">
            <div><i class="fa-solid fa-house"></i></div>
            <p>All</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-umbrella-beach"></i></div>
            <p>Beach</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-house-chimney"></i></div>
            <p>Cabins</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-water"></i></div>
            <p>Amazing pools</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-mountain"></i></div>
            <p>Mountains</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-tree"></i></div>
            <p>Countryside</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-couch"></i></div>
            <p>Design</p>
        </div>

        <div class="filter">
            <div><i class="fa-regular fa-gem"></i></div>
            <p>OMG!</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-house-user"></i></div>
            <p>Tiny homes</p>
        </div>

        <div class="filter">
            <div><i class="fa-solid fa-ellipsis"></i></div>
            <p>More</p>
        </div>
    </div>

    <div class="explore-heading">
        <h2>Explore stays</h2>

        <button>
            <i class="fa-regular fa-map"></i>
            Show map
        </button>
    </div>

    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for (let listing of allListings) { %>
            <a href="/listings/<%= listing._id %>" class="listing-link">
                <div class="card col listing-card">
                    <img src="<%= listing.image.url %>" class="card-img-top" style="height: 20rem" alt="listing_image">
                    <div class="card-img-overlay"></div>
                    <div class="card-body">
                        <p class="card-text"><b>
                                <%= listing.title %>
                            </b>
                            <br>
                            &#8377; <%= listing.price.toLocaleString('en-IN') %> / Night
                        </p>
                    </div>
                </div>
                <% } %>
            </a>
    </div>