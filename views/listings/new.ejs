    <% layout("/layouts/boilerplate") %>

    <div class="row">
        
        <DIV class="col-8 offset-2">
             <br>
            <h3 class="mb-3">Create a new listing</h3>
            <form action="/listings" method="POST">
                
                <div>
                    <label for="title" class="form-label">Title</label>
                    <input type="text" name="listing[title]" class="form-control" placeholder="Enter Title" required>
                </div>
                <br>
                
                <div>
                    <label for="desccription" class="form-label">Description</label>
                    <textarea name="listing[description]" class="form-control" placeholder="Enter Description" required></textarea>
                </div>
                <br>
                
                <div>
                    <label for="price" class="form-label">Price</label>
                    <input type="number" name="listing[price]" class="form-control" placeholder="Enter Price" required>
                </div>
                <br>
                
                <div class="row">
                <div class="col-6">
                    <label for="location" class="form-label">Location</label>
                    <input type="text" name="listing[location]" class="form-control" placeholder="Enter Location" required>
                </div>
                <br>
                
                <div class="col-6">
                    <label for="country" class="form-label">Country</label>
                    <input type="text" name="listing[country]" class="form-control" placeholder="Enter Country" required>
                </div>
                 </div>
                <br>

                
                <div>
                    <label for="location" class="form-label">Image URL</label>
                    <input type="text" name="listing[image]" class="form-control"  placeholder="Enter Image URL" required>
                </div>
                <br>    
                
                <button type="submit" class="btn btn-dark add-btn">Create Listing</button>
                <br><br><br>
            </form>
            
            
        </body>
        </html>
    </DIV>
    </div>