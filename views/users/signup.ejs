<% layout("/layouts/boilerplate") %>

<div class="auth-page">

    <!-- Background image -->
    <div class="auth-background"></div>

    <!-- Dark overlay -->
    <div class="auth-background-overlay"></div>


    <!-- LEFT CONTENT -->
    <div class="auth-left">

        <div class="auth-left-content">

            <h2>Homgobnb</h2>

            <h1>
                Your Journey<br>
                Starts<br>
                Here
            </h1>

            <p>
                Join Homgobnb and discover beautiful places,
                comfortable stays, and unforgettable experiences.
            </p>

        </div>

    </div>


    <!-- RIGHT SIGNUP CARD -->
    <div class="auth-right">

        <div class="auth-card">

            <h1>Create Account</h1>

            <p class="auth-subtitle">
                Join Homgobnb today
            </p>


            <form action="/signup" method="POST" class="needs-validation" novalidate>

                <!-- Username -->
                <div class="auth-input-group">

                    <label for="username">
                        Username
                    </label>

                    <input
                        type="text"
                        id="username"
                        name="username"
                        placeholder="Choose a username"
                        required
                    >

                    <div class="invalid-feedback">
                        Please enter a valid username.
                    </div>

                </div>


                <!-- Email -->
                <div class="auth-input-group">

                    <label for="email">
                        Email
                    </label>

                    <input
                        type="email"
                        id="email"
                        name="email"
                        placeholder="Enter your email"
                        required
                    >

                </div>


                <!-- Password -->
                <div class="auth-input-group">

                    <label for="password">
                        Password
                    </label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Create a password"
                        required
                    >

                </div>


                <!-- Signup button -->
                <button type="submit" class="auth-submit">
                    Create Account
                </button>

            </form>


            <!-- Login link -->
            <p class="auth-switch">
                Already have an account?
                <a href="/login">Login</a>
            </p>

        </div>

    </div>

</div>